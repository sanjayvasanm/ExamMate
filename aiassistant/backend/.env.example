# Flask backend
JWT_SECRET=replace-with-a-long-random-secret
ENVIRONMENT=development
PORT=5000
CORS_ORIGINS=http://localhost:8080

# Supabase (server-side only; use the service-role key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-the-server-side-service-role-key
SUPABASE_STORAGE_BUCKET=exam-documents
DOCUMENT_CHUNKS_TABLE=document_chunks

# Groq (exam answers & AI tutor)
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (flashcards & quizzes)
GEMINI_API_KEY=replace-with-your-gemini-api-key
